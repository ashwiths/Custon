{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Custun",
  "version": "0.1.0",
  "identifier": "com.infan.custon",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Custun",
        "width": 1024,
        "height": 768
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/32x32.png",
        "sidebarImage": "icons/128x128.png",
        "displayLanguageSelector": false,
        "installerHooks": "nsis/installer_hooks.nsh"
      }
    }
  }
}
